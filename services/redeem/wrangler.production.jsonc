{
  "name": "gl-redeem",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gl-redeem",
      "database_id": "0d8b2d98-c1e5-4e3c-b651-70ce98b548bd"
    }
  ],
  "vars": {
    "ALLOWED_APPS": "DSHALEV",
    "MAX_SECUNDARIAS": "0",
    "SERVICE_KID": "gl-redeem-v1",
    "MAX_CLOCK_SKEW_MS": "300000"
  },
  "ratelimits": [
    {
      "name": "RL_IP",
      "namespace_id": "1002",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "RL_DEVICE",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
